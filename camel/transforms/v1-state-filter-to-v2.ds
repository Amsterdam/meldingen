local rawState = if body == null then '' else std.toString(body);

local normalizeState(state) =
  std.asciiLower(
    std.strReplace(
      std.strReplace(std.toString(state), ' ', '_'),
      '-',
      '_'
    )
  );

local mapStateToV2(state) =
  local normalized = normalizeState(state);
  if normalized == '' then []
  else if normalized == 'm' then ['submitted']
  else if normalized == 'i' then ['processing_requested']
  else if normalized == 'b' then ['processing']
  else if normalized == 'ingepland' then ['planned']
  else if normalized == 'o' then ['completed']
  else if normalized == 'a' then ['canceled']
  else if normalized == 'reopen_requested' then ['reopen_requested']
  else if normalized == 'reopened' then ['reopened']
  else if normalized == 'submitted' then ['submitted']
  else if normalized == 'processing_requested' then ['processing_requested']
  else if normalized == 'processing' then ['processing']
  else if normalized == 'planned' then ['planned']
  else if normalized == 'completed' then ['completed']
  else if normalized == 'canceled' || normalized == 'cancelled' then ['canceled']
  else [normalized];

local states = if rawState == '' then [] else std.split(rawState, ',');

  std.join(',', std.flattenArrays(std.map(function(state) mapStateToV2(state), states)))