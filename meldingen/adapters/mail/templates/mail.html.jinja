<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
  </head>
  <body style="margin:0;padding:0;background-color:#ffffff;color:#000000;font-family:Helvetica,Arial,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;">{{ preview_text }}</div>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
      <tr>
        <td align="center" style="padding:24px 16px;">
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;">
            <tr>
              <td style="padding-bottom:24px;">
                <img src="{{ logo_src }}" width="115" height="40" alt="Gemeente Amsterdam" style="display:block;border:none;" />
              </td>
            </tr>
            <tr>
              <td>
                <h1 style="margin:0 0 16px 0;font-size:28px;line-height:36px;">{{ title }}</h1>
                {{ body_html }}
              </td>
            </tr>
            <tr>
              <td style="padding-top:24px;border-top:1px solid #b4b4b4;">
                <p style="margin:0;font-size:14px;line-height:22px;color:#4f4f4f;">{{ disclaimer }}</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
